    given-names: Daniel Ari
    orcid: "0000-0001-6232-9096"
    affiliation: Active Inference Institute
keywords:
  - OOXML
  - DOCX
  - ODF
  - ODT
  - Open Packaging Conventions
  - steganography
  - document security
  - structured documents
  - reproducible research
